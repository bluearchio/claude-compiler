{
  "sessionDataFormat": {
    "version": "1.0.0",
    "schema": {
      "sessionMetadata": {
        "sessionId": {
          "type": "string",
          "required": true,
          "format": "session-{timestamp}",
          "description": "Unique session identifier"
        },
        "timestamp": {
          "type": "string", 
          "required": true,
          "format": "ISO 8601",
          "description": "Session start timestamp"
        },
        "claudeCodeVersion": {
          "type": "string",
          "required": false,
          "description": "Version of Claude Code being used"
        },
        "workingDirectory": {
          "type": "string",
          "required": true,
          "description": "Current working directory path"
        }
      },
      "taskAnalysis": {
        "userPrompt": {
          "type": "string",
          "required": true,
          "description": "Original user input"
        },
        "classification": {
          "type": "object",
          "required": true,
          "properties": {
            "complexity": {
              "type": "string",
              "enum": ["simple", "moderate", "complex", "veryComplex"],
              "required": true
            },
            "wordCount": {
              "type": "number",
              "required": true
            },
            "estimatedSteps": {
              "type": "number",
              "required": true
            },
            "riskLevel": {
              "type": "string",
              "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
              "required": true
            }
          }
        },
        "triggerWords": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Detected trigger words requiring compiler"
        },
        "domainClassification": {
          "type": "string",
          "enum": ["web_development", "backend", "devops", "testing", "data", "security", "general"],
          "required": true
        }
      },
      "agentSelection": {
        "selectedAgent": {
          "type": "string",
          "required": true,
          "description": "Primary agent selected for task"
        },
        "selectionReasoning": {
          "type": "object",
          "required": true,
          "properties": {
            "domainScore": {"type": "number"},
            "complexityScore": {"type": "number"},
            "triggerScore": {"type": "number"},
            "riskScore": {"type": "number"},
            "totalScore": {"type": "number"}
          }
        },
        "agentChain": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Multi-agent execution chain if applicable"
        },
        "alternativeAgents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {"type": "string"},
              "score": {"type": "number"},
              "reason": {"type": "string"}
            }
          }
        }
      },
      "compilerDecision": {
        "requiresCompiler": {
          "type": "boolean",
          "required": true
        },
        "reason": {
          "type": "string",
          "required": true,
          "description": "Why compiler is/isn't required"
        },
        "compilerMode": {
          "type": "string",
          "enum": ["verification", "orchestration", "tracking", "full"],
          "required": false
        }
      },
      "executionPlan": {
        "approach": {
          "type": "string",
          "enum": ["direct", "compiler", "multi-agent", "orchestrated"],
          "required": true
        },
        "estimatedDuration": {
          "type": "string",
          "description": "Expected execution time"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {"type": "number"},
              "description": {"type": "string"},
              "agent": {"type": "string"},
              "dependencies": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "outputLocation": {
      "directory": "./claude-compiler/session-data",
      "filename": "{sessionId}.json",
      "backup": "./claude-compiler/session-data/backup/{date}/{sessionId}.json"
    },
    "auditLevels": {
      "basic": {
        "includeFields": ["sessionMetadata", "taskAnalysis.userPrompt", "agentSelection.selectedAgent", "compilerDecision.requiresCompiler"],
        "verbosity": "minimal"
      },
      "standard": {
        "includeFields": ["sessionMetadata", "taskAnalysis", "agentSelection", "compilerDecision"],
        "verbosity": "standard"
      },
      "detailed": {
        "includeFields": ["sessionMetadata", "taskAnalysis", "agentSelection", "compilerDecision", "executionPlan"],
        "verbosity": "detailed"
      },
      "comprehensive": {
        "includeFields": ["*"],
        "verbosity": "full",
        "includeTimestamps": true,
        "includeEnvironment": true,
        "includeDecisionTree": true
      }
    }
  },
  "publishingOptions": {
    "realTime": true,
    "compression": false,
    "encryption": false,
    "retention": {
      "days": 30,
      "autoCleanup": true
    },
    "formats": {
      "json": {
        "enabled": true,
        "pretty": true
      },
      "csv": {
        "enabled": false,
        "fields": ["sessionId", "timestamp", "userPrompt", "selectedAgent", "requiresCompiler"]
      },
      "database": {
        "enabled": true,
        "connection": "sqlite://./db/tasks.db",
        "table": "session_tracking"
      }
    }
  },
  "integrationHooks": {
    "beforeSession": "validate session environment",
    "afterAnalysis": "log analysis results", 
    "afterAgentSelection": "record agent selection reasoning",
    "afterExecution": "publish complete session data",
    "onError": "log error and maintain audit trail"
  }
}