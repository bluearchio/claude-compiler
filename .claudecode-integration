#!/usr/bin/env node

/**
 * CLAUDE CODE AUTOMATIC INTEGRATION DETECTOR
 * 
 * This file FORCES Claude Code to use the Claude Compiler system
 * whenever it exists in the project directory.
 * 
 * CRITICAL: This must be executed at the start of every Claude Code session
 */

const fs = require('fs');
const path = require('path');

// Colors for output
const colors = {
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  blue: '\x1b[34m',
  cyan: '\x1b[36m',
  bold: '\x1b[1m',
  reset: '\x1b[0m'
};

function log(message, color = 'reset') {
  console.log(`${colors[color]}${message}${colors.reset}`);
}

function detectClaudeCompiler() {
  const currentDir = process.cwd();
  const claudeCompilerPath = path.join(currentDir, 'claude-compiler');
  
  // Check if Claude Compiler exists
  if (fs.existsSync(claudeCompilerPath)) {
    log('╔══════════════════════════════════════════════════════════════════════╗', 'blue');
    log('║                    CLAUDE COMPILER DETECTED                           ║', 'bold');
    log('║                  ENFORCING SYSTEM INTEGRATION                         ║', 'bold');
    log('╚══════════════════════════════════════════════════════════════════════╝', 'blue');
    log('', 'reset');
    log('🎯 CLAUDE CODE INTEGRATION ACTIVE', 'green');
    log('📁 Location: ' + claudeCompilerPath, 'cyan');
    log('⚡ Status: OPERATIONAL', 'green');
    log('', 'reset');
    
    // Check for master orchestrator
    const masterPath = path.join(claudeCompilerPath, 'claude-master.js');
    if (fs.existsSync(masterPath)) {
      log('🚀 MASTER ORCHESTRATOR: AVAILABLE', 'green');
      log('   Usage: node claude-compiler/claude-master.js "your task"', 'cyan');
    }
    
    // Check for CLAUDE.md
    const claudeMdPath = path.join(claudeCompilerPath, 'CLAUDE.md');
    if (fs.existsSync(claudeMdPath)) {
      log('📋 CLAUDE.md: FOUND', 'green');
      log('   ⚠️  CRITICAL: All sessions MUST read this file first', 'yellow');
    }
    
    log('', 'reset');
    log('⚠️  ENFORCEMENT RULES:', 'yellow');
    log('   1. ALL complex tasks MUST use Claude Compiler', 'yellow');
    log('   2. ALL multi-step instructions MUST be verified', 'yellow');
    log('   3. ALL agent coordination MUST go through Master Orchestrator', 'yellow');
    log('   4. ALL sessions MUST read CLAUDE.md first', 'yellow');
    log('', 'reset');
    log('🔐 VERIFICATION: System will track all operations', 'cyan');
    log('📊 MONITORING: Complete audit trail maintained', 'cyan');
    log('', 'reset');
    
    return true;
  }
  
  return false;
}

function enforceIntegration() {
  log('🛡️  CLAUDE COMPILER ENFORCEMENT ACTIVE', 'bold');
  log('', 'reset');
  
  // Set environment variable to signal integration
  process.env.CLAUDE_COMPILER_ACTIVE = 'true';
  process.env.CLAUDE_COMPILER_PATH = path.join(process.cwd(), 'claude-compiler');
  
  log('✅ Environment variables set:', 'green');
  log('   CLAUDE_COMPILER_ACTIVE=true', 'cyan');
  log('   CLAUDE_COMPILER_PATH=' + process.env.CLAUDE_COMPILER_PATH, 'cyan');
  
  return true;
}

function showUsageInstructions() {
  log('', 'reset');
  log('📖 USAGE INSTRUCTIONS FOR CLAUDE CODE:', 'bold');
  log('════════════════════════════════════════', 'blue');
  log('', 'reset');
  log('For ANY complex task, use:', 'cyan');
  log('  node claude-compiler/claude-master.js "your instruction here"', 'green');
  log('', 'reset');
  log('For monitoring:', 'cyan');
  log('  node claude-compiler/flows/task-tracker.js monitor', 'green');
  log('', 'reset');
  log('For status:', 'cyan');
  log('  node claude-compiler/flows/task-tracker.js status', 'green');
  log('', 'reset');
  log('⚡ TRIGGER WORDS that require Claude Compiler:', 'yellow');
  log('   - "ensure", "coordinate", "align all", "workflow"', 'yellow');
  log('   - Multi-step processes, deployments, testing', 'yellow');
  log('   - Agent coordination, complex integrations', 'yellow');
  log('', 'reset');
}

// Main execution
if (require.main === module) {
  log('🔍 Checking for Claude Compiler integration...', 'cyan');
  
  if (detectClaudeCompiler()) {
    enforceIntegration();
    showUsageInstructions();
    
    log('🎉 CLAUDE COMPILER INTEGRATION COMPLETE', 'green');
    log('   All future Claude Code operations will use this system', 'green');
    process.exit(0);
  } else {
    log('❌ Claude Compiler not found in current directory', 'red');
    log('   Claude Code will use standard behavior', 'yellow');
    process.exit(1);
  }
}

module.exports = {
  detectClaudeCompiler,
  enforceIntegration
};