{
  "id": "safe-npm-publish",
  "description": "Safely publish npm package with all checks",
  "steps": [
    {
      "id": "check-git-clean",
      "description": "Ensure git working directory is clean",
      "action": {
        "type": "command",
        "command": "git status --porcelain"
      },
      "verification": {
        "type": "equals",
        "value": ""
      },
      "dependencies": []
    },
    {
      "id": "run-lint",
      "description": "Check code quality",
      "action": {
        "type": "command",
        "command": "npm run lint"
      },
      "verification": {
        "type": "contains",
        "text": "0 problems"
      },
      "dependencies": ["check-git-clean"]
    },
    {
      "id": "run-tests",
      "description": "Execute test suite",
      "action": {
        "type": "command",
        "command": "npm test"
      },
      "verification": {
        "type": "contains",
        "text": "passing"
      },
      "dependencies": ["run-lint"]
    },
    {
      "id": "check-coverage",
      "description": "Verify test coverage",
      "action": {
        "type": "command",
        "command": "npm run test:coverage"
      },
      "verification": {
        "type": "contains",
        "text": "Coverage"
      },
      "dependencies": ["run-tests"]
    },
    {
      "id": "build-package",
      "description": "Build distribution files",
      "action": {
        "type": "command",
        "command": "npm run build"
      },
      "verification": {
        "type": "file_exists",
        "path": "dist"
      },
      "dependencies": ["check-coverage"]
    },
    {
      "id": "version-bump",
      "description": "Bump package version",
      "action": {
        "type": "command",
        "command": "npm version patch"
      },
      "verification": {
        "type": "contains",
        "text": "v"
      },
      "dependencies": ["build-package"]
    },
    {
      "id": "npm-publish-dry",
      "description": "Dry run npm publish",
      "action": {
        "type": "command",
        "command": "npm publish --dry-run"
      },
      "verification": {
        "type": "contains",
        "text": "npm notice"
      },
      "dependencies": ["version-bump"]
    },
    {
      "id": "git-tag",
      "description": "Create git tag",
      "action": {
        "type": "command",
        "command": "git push --tags"
      },
      "verification": {
        "type": "contains",
        "text": ""
      },
      "dependencies": ["npm-publish-dry"]
    },
    {
      "id": "npm-publish",
      "description": "Publish to npm registry",
      "action": {
        "type": "command",
        "command": "npm publish"
      },
      "verification": {
        "type": "contains",
        "text": "+"
      },
      "dependencies": ["git-tag"]
    }
  ],
  "constraints": [
    {
      "type": "file_exists",
      "path": "package.json",
      "description": "Must be npm package"
    },
    {
      "type": "file_exists",
      "path": ".gitignore",
      "description": "Must have gitignore"
    },
    {
      "type": "no_errors",
      "description": "Any error stops publish"
    }
  ],
  "resources": {
    "files": ["package.json", "dist/", "src/"]
  },
  "verification": {
    "type": "test_passes"
  }
}