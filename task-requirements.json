{
  "taskClassification": {
    "simple": {
      "criteria": {
        "wordCount": {"max": 10},
        "steps": {"max": 1},
        "dependencies": {"max": 0},
        "riskLevel": "LOW"
      },
      "examples": [
        "create hello world",
        "list files", 
        "show status",
        "simple query"
      ],
      "requiresCompiler": false,
      "defaultAgent": "general-purpose"
    },
    "moderate": {
      "criteria": {
        "wordCount": {"min": 10, "max": 25},
        "steps": {"min": 2, "max": 3},
        "dependencies": {"max": 1},
        "riskLevel": "LOW"
      },
      "triggerWords": ["with", "and", "then", "also"],
      "examples": [
        "create app with tests",
        "deploy and monitor",
        "build then test"
      ],
      "requiresCompiler": true,
      "defaultAgent": "workflow-orchestrator"
    },
    "complex": {
      "criteria": {
        "wordCount": {"min": 25},
        "steps": {"min": 3},
        "dependencies": {"min": 1},
        "riskLevel": "MEDIUM"
      },
      "triggerWords": [
        "ensure", "coordinate", "workflow", "orchestrate",
        "integrate", "systematic", "comprehensive"
      ],
      "examples": [
        "ensure deployment follows workflow with testing and monitoring",
        "coordinate multiple services with comprehensive integration"
      ],
      "requiresCompiler": true,
      "defaultAgent": "workflow-orchestrator"
    },
    "veryComplex": {
      "criteria": {
        "wordCount": {"min": 30},
        "steps": {"min": 5},
        "dependencies": {"min": 2},
        "riskLevel": "HIGH"
      },
      "triggerWords": [
        "production", "deploy", "migrate", "refactor",
        "architecture", "infrastructure", "security"
      ],
      "examples": [
        "migrate production database with zero downtime and complete rollback capability",
        "refactor architecture ensuring security and performance across all services"
      ],
      "requiresCompiler": true,
      "defaultAgent": "technical-architect-lead"
    }
  },
  "agentSelection": {
    "criteria": {
      "domainMatching": {
        "weight": 30,
        "domains": {
          "web_development": ["html", "css", "javascript", "react", "frontend"],
          "backend": ["api", "server", "database", "backend"],
          "devops": ["deploy", "ci/cd", "infrastructure", "docker", "kubernetes"],
          "testing": ["test", "qa", "validation", "verification"],
          "data": ["pipeline", "etl", "analytics", "processing"],
          "security": ["auth", "encryption", "secure", "vulnerability"]
        }
      },
      "complexityMatching": {
        "weight": 25,
        "mapping": {
          "simple": ["general-purpose"],
          "moderate": ["workflow-orchestrator", "quality-assurance-guardian"],
          "complex": ["workflow-orchestrator", "technical-architect-lead"],
          "veryComplex": ["technical-architect-lead", "devops-deployment-engineer"]
        }
      },
      "triggerWordMatching": {
        "weight": 35,
        "mapping": {
          "workflow-orchestrator": ["coordinate", "orchestrate", "workflow", "manage"],
          "quality-assurance-guardian": ["test", "verify", "validate", "quality"],
          "technical-architect-lead": ["architecture", "design", "structure", "refactor"],
          "devops-deployment-engineer": ["deploy", "infrastructure", "ci/cd", "production"],
          "data-pipeline-architect": ["pipeline", "etl", "data", "processing"],
          "project-manager-analyst": ["plan", "organize", "requirements", "breakdown"]
        }
      },
      "riskMatching": {
        "weight": 10,
        "mapping": {
          "LOW": ["general-purpose", "quality-assurance-guardian"],
          "MEDIUM": ["workflow-orchestrator", "technical-architect-lead"],
          "HIGH": ["technical-architect-lead", "devops-deployment-engineer"]
        }
      }
    },
    "fallback": "general-purpose",
    "multiAgentThreshold": {
      "complexity": "complex",
      "wordCount": 20,
      "triggerCount": 3
    }
  },
  "compilerRequirements": {
    "alwaysRequired": [
      "production", "deploy", "migration", "security",
      "coordinate", "orchestrate", "workflow", "ensure"
    ],
    "conditionalRequired": {
      "multiStep": {"minSteps": 2},
      "complexity": {"minLevel": "moderate"},
      "riskLevel": {"minLevel": "MEDIUM"},
      "wordCount": {"min": 15}
    }
  },
  "sessionTracking": {
    "requiredFields": [
      "sessionId", "userPrompt", "taskClassification", 
      "selectedAgent", "requiresCompiler", "riskLevel"
    ],
    "auditLevel": {
      "simple": "basic",
      "moderate": "standard", 
      "complex": "detailed",
      "veryComplex": "comprehensive"
    }
  }
}